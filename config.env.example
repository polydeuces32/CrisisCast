# CrisisCast Configuration
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here
DATABASE_URL=postgresql://user:password@localhost:5432/crisiscast
REDIS_URL=redis://localhost:6379/0

# External API Keys
OPENAI_API_KEY=your_openai_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_key_here

# Scrapy Settings
SCRAPY_DELAY=1
SCRAPY_CONCURRENT_REQUESTS=16
SCRAPY_CONCURRENT_REQUESTS_PER_DOMAIN=8

# Model Settings
MODEL_UPDATE_INTERVAL=3600  # seconds
FORECAST_HORIZON_DAYS=180  # 6 months
VOLATILITY_WINDOW_DAYS=30

# Alert Settings
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USERNAME=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password
